# Local development
DATABASE_PATH=server/expense_tracker.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173

# Optional email notifications (leave blank if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_TLS=false
SMTP_START_TLS=true

# Frontend build-time variable. Set this in the Render Static Site environment
# to the backend hostname or URL, e.g. https://expense-tracker-api.onrender.com
# VITE_API_URL=
